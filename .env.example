DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
TELEGRAM_BOT_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./dev.db
LOG_LEVEL=INFO
ENV=development

# FSM persistence — use redis://localhost:6379/0 for local dev, redis://redis:6379/0 in Docker
REDIS_URL=redis://redis:6379/0

# HuggingFace model cache dir (fastembed downloads ONNX model here on first run)
HF_HOME=/app/.cache/huggingface

# RAG / Qdrant
QDRANT_URL=http://10.42.0.19:6333
QDRANT_API_KEY=          # leave empty for unauthenticated local Qdrant; set for auth-enabled instances
QDRANT_COLLECTION=kontur_kb
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.0
